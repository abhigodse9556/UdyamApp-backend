model Store {
  id                  String     @id @default(cuid())
  user                User    @relation(fields: [userId], references: [id])
  userId              String
  contactPersonName   String
  storeName           String
  storeShortName      String?
  phone               String  @unique
  businessWhatsapp    String? @unique
  businessEmail       String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  country             String?
  pincode             String?
  gstin               String?
  licence             String?
}

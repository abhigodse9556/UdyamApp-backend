model User {
  id            String     @id @default(cuid())
  email         String     @unique
  userName      String     @unique
  name          String
  mobile        String    @unique
  stores        Store[]
  passwordHash  String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  isActive      Boolean    @default(true)

  refreshSessions RefreshSession[]
}
